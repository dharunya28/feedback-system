# ==============================================================
# ONLINE SURVEY / FEEDBACK SYSTEM - ENVIRONMENT TEMPLATE
# Copy this file to server/.env for local development
# Set these variables in Render Dashboard under 'Environment'
# ==============================================================

# Server Port (Render sets this automatically)
PORT=5000

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/feedback_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/feedback_db?retryWrites=true&w=majority
