{
  "name": "feedback-system",
  "version": "1.0.0",
  "description": "Online Survey and Feedback Management System",
  "main": "server/server.js",
  "scripts": {
    "install:client": "npm --prefix client install",
    "install:server": "npm --prefix server install",
    "build:client": "npm --prefix client run build",
    "build": "npm run install:server && npm run install:client && npm run build:client",
    "start": "node server/server.js",
    "test": "node tests/verifyFeedback.js",
    "server": "npm --prefix server start",
    "client": "npm --prefix client run dev"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "feedback",
    "survey",
    "react",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC"
}
